page {
  min-height: 100%;
  background: #edf3fb;
  color: #0f2442;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1.2;
  background: transparent;
  text-align: left;
}

.page {
  min-height: 100vh;
  padding: 18rpx 26rpx 150rpx;
  box-sizing: border-box;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  margin: -18rpx -26rpx 22rpx;
  padding: 22rpx 26rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  background: rgba(247, 250, 255, 0.96);
  border-bottom: 1rpx solid rgba(15, 36, 66, 0.08);
}

.brand {
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.brand-logo {
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 auto;
}

.brand-copy {
  min-width: 0;
  display: grid;
  gap: 2rpx;
}

.brand-name {
  color: #071c38;
  font-size: 32rpx;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.brand-sub {
  color: #55708f;
  font-size: 18rpx;
  font-weight: 700;
}

.top-actions {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.user-pill,
.ghost-button,
.small-button {
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.user-pill {
  max-width: 150rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #0f2442;
}

.ghost-button {
  padding: 13rpx 18rpx;
  color: #0d4dc4;
  background: rgba(13, 83, 220, 0.1);
}

.screen {
  display: grid;
  gap: 24rpx;
}

.hero-card {
  min-height: 640rpx;
  position: relative;
  overflow: hidden;
  border-radius: 12rpx;
  background: #07142c;
  box-shadow: 0 24rpx 58rpx rgba(5, 19, 43, 0.2);
}

.hero-cover {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0.78;
}

.hero-card::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(180deg, rgba(5, 12, 29, 0.36), rgba(5, 12, 29, 0.22) 38%, rgba(5, 12, 29, 0.8)),
    linear-gradient(90deg, rgba(8, 45, 58, 0.55), transparent 58%);
}

.hero-overlay,
.hero-badge-card,
.hero-live {
  position: relative;
  z-index: 2;
}

.hero-overlay {
  padding: 42rpx 36rpx 0;
  display: grid;
  gap: 18rpx;
}

.hero-eyebrow {
  color: rgba(255, 255, 255, 0.75);
  font-size: 22rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.hero-title {
  max-width: 520rpx;
  color: #fff;
  font-size: 60rpx;
  line-height: 1.08;
  font-weight: 900;
}

.hero-desc {
  max-width: 520rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.65;
  font-weight: 700;
}

.hero-semester {
  display: inline-flex;
  width: fit-content;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.14);
  font-size: 20rpx;
  font-weight: 900;
}

.hero-badge-card {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: min(76vw, 360rpx);
  padding: 22rpx;
  border-radius: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  background: rgba(8, 18, 38, 0.68);
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.hero-badge-logo {
  width: 84rpx;
  height: 84rpx;
  flex: 0 0 auto;
}

.hero-badge-copy {
  min-width: 0;
  display: grid;
  gap: 6rpx;
}

.hero-badge-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}

.hero-badge-sub {
  color: rgba(255, 255, 255, 0.74);
  font-size: 22rpx;
  line-height: 1.55;
  font-weight: 700;
}

.panel {
  padding: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(60, 123, 220, 0.32);
  background: rgba(250, 253, 255, 0.96);
  box-shadow: 0 14rpx 36rpx rgba(37, 74, 128, 0.08);
}

.panel-head {
  min-width: 0;
  margin-bottom: 24rpx;
  display: grid;
  gap: 6rpx;
}

.panel-kicker {
  color: #0d66e8;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.panel-title {
  color: #061a35;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
}

.notice-panel {
  background: #f7fbff;
}

.lead-notice {
  overflow: hidden;
  border-radius: 14rpx;
  background: #0c1e45;
}

.lead-notice-media {
  height: 290rpx;
  overflow: hidden;
}

.lead-notice-media image {
  width: 100%;
  height: 100%;
}

.lead-notice-copy {
  padding: 20rpx 22rpx 24rpx;
  display: grid;
  gap: 8rpx;
}

.lead-notice-tag {
  color: #7fb1ff;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.lead-notice-title {
  color: #fff;
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 900;
}

.lead-notice-text {
  color: rgba(255, 255, 255, 0.74);
  font-size: 23rpx;
  line-height: 1.55;
}

.lead-notice-time {
  color: rgba(255, 255, 255, 0.85);
  font-size: 22rpx;
  font-weight: 800;
}

.notice-list {
  margin-top: 22rpx;
  display: grid;
  gap: 0;
}

.notice-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(59, 118, 210, 0.26);
}

.notice-top {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}

.notice-title {
  flex: 1;
  min-width: 0;
  color: #0f2442;
  font-size: 27rpx;
  line-height: 1.42;
  font-weight: 900;
}

.notice-time {
  flex: 0 0 auto;
  color: #0d66e8;
  font-size: 22rpx;
  font-weight: 900;
}

.notice-sub {
  display: block;
  margin-top: 12rpx;
  color: #456b9b;
  font-size: 21rpx;
  font-weight: 800;
}

.notice-content {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.55;
}

.entry-grid {
  display: grid;
  gap: 22rpx;
}

.entry-card {
  min-height: 280rpx;
  position: relative;
  overflow: hidden;
  padding: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(52, 115, 222, 0.32);
  background: #fff;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 16rpx;
}

.entry-card::after {
  content: "";
  position: absolute;
  right: -70rpx;
  bottom: -90rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(42, 115, 232, 0.14);
}

.entry-index,
.entry-logo,
.entry-copy,
.entry-action {
  position: relative;
  z-index: 1;
}

.entry-index {
  color: #657c9a;
  font-size: 22rpx;
  font-weight: 900;
}

.entry-logo {
  width: 84rpx;
  height: 84rpx;
  justify-self: end;
}

.entry-copy {
  grid-column: 1 / -1;
  min-width: 0;
  display: grid;
  gap: 10rpx;
}

.entry-badge {
  color: #0d66e8;
  font-size: 22rpx;
  font-weight: 900;
}

.entry-title {
  color: #0f2442;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 900;
}

.entry-desc {
  max-width: 460rpx;
  color: #526981;
  font-size: 25rpx;
  line-height: 1.6;
  font-weight: 700;
}

.entry-action {
  position: absolute;
  right: 30rpx;
  bottom: 28rpx;
  color: #0d66e8;
  font-size: 25rpx;
  font-weight: 900;
}

.dept-panel {
  display: grid;
  gap: 24rpx;
}

.dept-group {
  border-top: 1rpx solid rgba(59, 118, 210, 0.28);
  padding-top: 22rpx;
}

.dept-group-head {
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.dept-group-index {
  color: #0d66e8;
  font-size: 22rpx;
  font-weight: 900;
}

.dept-group-title {
  color: #0f2442;
  font-size: 28rpx;
  font-weight: 900;
}

.dept-card-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.dept-card {
  min-height: 170rpx;
  padding: 20rpx 18rpx;
  border-radius: 18rpx;
  border: 1rpx solid rgba(63, 123, 214, 0.24);
  color: #183553;
  background: linear-gradient(180deg, #f8fbff, #eef5ff);
  display: grid;
  gap: 8rpx;
  text-align: left;
}

.dept-card-label {
  color: #0d66e8;
  font-size: 20rpx;
  font-weight: 900;
}

.dept-card-name {
  color: #0f2442;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 900;
}

.dept-card-sub {
  color: #5e7188;
  font-size: 21rpx;
  line-height: 1.45;
  font-weight: 700;
}

.dept-detail-panel {
  display: grid;
  gap: 18rpx;
}

.dept-detail {
  display: grid;
  gap: 18rpx;
}

.dept-detail-hero {
  overflow: hidden;
  border-radius: 18rpx;
  background: #0c1e45;
}

.dept-detail-cover {
  width: 100%;
  height: 320rpx;
}

.dept-detail-copy {
  padding: 22rpx;
  display: grid;
  gap: 8rpx;
}

.dept-detail-org {
  color: #7fb1ff;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.dept-detail-title {
  color: #fff;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 900;
}

.dept-detail-summary {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.6;
  font-weight: 700;
}

.dept-detail-meta {
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #f5f9ff;
  color: #0f2442;
  font-size: 25rpx;
  font-weight: 800;
}

.dept-notice-list {
  display: grid;
  gap: 14rpx;
}

.dept-notice-card {
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  background: #fff;
  border: 1rpx solid rgba(59, 118, 210, 0.18);
}

.dept-notice-title {
  display: block;
  color: #0f2442;
  font-size: 27rpx;
  line-height: 1.4;
  font-weight: 900;
}

.dept-notice-meta {
  display: block;
  margin-top: 8rpx;
  color: #53708f;
  font-size: 21rpx;
  font-weight: 800;
}

.dept-notice-summary {
  display: block;
  margin-top: 10rpx;
  color: #445a74;
  font-size: 23rpx;
  line-height: 1.58;
  font-weight: 700;
}

.login-panel,
.form-panel,
.bridge-panel,
.list-panel {
  margin-top: 22rpx;
}

.field,
.textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
}

.field,
.textarea {
  margin-top: 16rpx;
  padding: 24rpx 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(35, 72, 118, 0.16);
  background: #fff;
  color: #0f2442;
  font-size: 28rpx;
}

.textarea {
  min-height: 230rpx;
}

.picker-field {
  margin-top: 16rpx;
  padding: 22rpx;
  border-radius: 14rpx;
  border: 1rpx solid rgba(35, 72, 118, 0.12);
  background: #f5f9ff;
  display: grid;
  gap: 12rpx;
}

.picker-field > text {
  color: #506782;
  font-size: 22rpx;
  font-weight: 900;
}

.picker-value {
  color: #0f2442;
  font-size: 28rpx;
  font-weight: 900;
}

.checkbox-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #223d5d;
  font-size: 24rpx;
  font-weight: 800;
}

.primary-button {
  margin-top: 20rpx;
  width: 100%;
  padding: 26rpx 22rpx;
  border-radius: 14rpx;
  color: #fff;
  background: linear-gradient(135deg, #0d66e8, #0d3b90);
  text-align: center;
  font-size: 28rpx;
  font-weight: 900;
}

.hint,
.empty-block {
  display: block;
  color: #61758d;
  font-size: 24rpx;
  line-height: 1.65;
  font-weight: 700;
}

.hint {
  margin-top: 14rpx;
}

.small-button {
  width: fit-content;
  margin-top: 8rpx;
  padding: 12rpx 18rpx;
  color: #0d66e8;
  background: rgba(13, 102, 232, 0.1);
}

.bridge-lead {
  color: #536b84;
  font-size: 26rpx;
  line-height: 1.7;
  font-weight: 700;
}

.bridge-grid {
  margin-top: 22rpx;
  display: grid;
  gap: 14rpx;
}

.bridge-card {
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f5f9ff;
  border: 1rpx solid rgba(59, 118, 210, 0.2);
  display: flex;
  gap: 16rpx;
}

.bridge-card-step {
  color: #0d66e8;
  font-size: 22rpx;
  font-weight: 900;
}

.bridge-card-text {
  flex: 1;
  min-width: 0;
  color: #1b3555;
  font-size: 25rpx;
  line-height: 1.55;
  font-weight: 800;
}

.my-card {
  margin-bottom: 18rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #f5f9ff;
  display: grid;
  gap: 6rpx;
}

.my-name {
  color: #0f2442;
  font-size: 32rpx;
  font-weight: 900;
}

.my-meta {
  color: #5c7088;
  font-size: 23rpx;
  font-weight: 800;
}

.feedback-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(59, 118, 210, 0.22);
}

.feedback-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.feedback-title {
  flex: 1;
  min-width: 0;
  color: #0f2442;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 900;
}

.status {
  color: #0d66e8;
  font-size: 22rpx;
  font-weight: 900;
}

.feedback-meta,
.feedback-time {
  display: block;
  margin-top: 8rpx;
  color: #5b7088;
  font-size: 22rpx;
  font-weight: 700;
}

.feedback-content {
  display: block;
  margin-top: 10rpx;
  color: #334d67;
  font-size: 24rpx;
  line-height: 1.6;
}

.bottom-dock {
  position: fixed;
  left: 50%;
  bottom: 30rpx;
  z-index: 30;
  width: calc(100vw - 64rpx);
  transform: translateX(-50%);
  padding: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 16rpx 42rpx rgba(13, 37, 72, 0.18);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
}

.dock-item {
  min-height: 72rpx;
  border-radius: 999rpx;
  color: #66758a;
  text-align: center;
  font-size: 23rpx;
  font-weight: 900;
}

.dock-item.active {
  color: #fff;
  background: #0d66e8;
}

.notice-open { margin-top: 16rpx; min-height: 88rpx; font-size: 28rpx; color: #173b64; background: #edf4ff; }
.notice-detail .panel-title { display: block; margin: 32rpx 0 16rpx; }
.notice-detail rich-text { display: block; margin-top: 32rpx; font-size: 30rpx; line-height: 1.8; }
